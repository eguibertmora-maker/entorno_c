{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar C en RAM",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-Wall",
                "${workspaceFolder}/general/src/main.c",
                "-o",
                "/tmp/app_c"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
